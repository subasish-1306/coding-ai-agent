# =============================================================================
# Coding AI Agent — Environment Variables
# Copy this file to .env and customize for your environment.
# Never commit the .env file.
# =============================================================================

# Application
APP_NAME=Coding AI Agent
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# Frontend
VITE_API_URL=https://coding-ai-agent-s67b.onrender.com
VITE_APP_NAME=Coding AI Agent

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=coding_ai_agent
POSTGRES_USER=coding_ai
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+asyncpg://coding_ai:change-me-in-production@postgres:5432/coding_ai_agent

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Security — replace with a strong generated value in every deployed environment
SECRET_KEY=change-me-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Observability (optional)
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# AI provider integration (not implemented in this scaffold)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
